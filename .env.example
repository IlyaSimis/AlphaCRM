# Скопируйте в .env или выполните scripts/init-env.sh — он сгенерирует случайные секреты.
# .env не коммитится.

POSTGRES_DB=quiet_clinic
POSTGRES_USER=quiet_clinic
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=55432

# Ключ шифрования клинических текстов (минимум 32 символа).
# Не меняйте его на существующей базе: ранее зашифрованные данные станут нечитаемыми.
CLINIC_KMS_KEY=change-me-to-a-random-64-hex-string

# Название клиники и пароль начального администратора (логин admin) для пустой базы.
# Пароль обязателен, не короче 12 символов и не «admin»; после первого входа его нужно сменить.
# Других сотрудников заводит администратор в разделе «Сотрудники».
CLINIC_NAME=AlphaCRM
# ФИО начального администратора на пустой базе
CLINIC_ADMIN_NAME=Администратор
CLINIC_ADMIN_PASSWORD=admin

# true — cookie сессии только по HTTPS (включите за reverse proxy с сертификатом).
SESSION_COOKIE_SECURE=false

# Внешние выводы (см. README, «Внешние выводы»). Пусто — ничего наружу не уходит.
# Вебхук клиники: свой бот или SMS-шлюз. Секрет подписи HMAC — минимум 32 случайных символа.
CLINIC_OUTBOUND_WEBHOOK_URL=
CLINIC_OUTBOUND_WEBHOOK_SECRET=
# Telegram-бот клиники (если вебхук не задан). Пациенту нужен chat id в карточке —
# пациенты, записавшиеся через бота, получают его автоматически. Этот же токен использует сервис bot.
TELEGRAM_BOT_TOKEN=
# Онлайн-касса для чеков и секрет подписи. Пусто — чек остаётся QUEUED.
CLINIC_CASHBOX_URL=
CLINIC_CASHBOX_SECRET=
# Часовой пояс клиники: смены врачей, окна в боте и время в сообщении пациенту
# (моменты в базе — UTC). Для клиники в Москве: Europe/Moscow.
CLINIC_TIME_ZONE=UTC

# --- Telegram-бот клиники (проект ClinicaBot) ---
# bot — поднять сервис бота вместе со стеком. Пусто — бот не запускается.
COMPOSE_PROFILES=
# Папка с исходниками бота: относительно этой папки или абсолютный путь.
BOT_SOURCE_DIR=../ClinicaBot
# Сервисный токен API бота в CRM (минимум 32 символа). scripts/init-env.sh создаёт случайный.
CLINIC_BOT_API_TOKEN=
# Услуга из справочника, на которую записывает бот (её длительность — длина окна).
CLINIC_BOT_SERVICE=Первичный приём
# Логин сотрудника для обращений «связаться с оператором»; пусто — первый активный администратор.
CLINIC_BOT_TASK_ASSIGNEE=
# Id клиники бота; нужен, только если клиник в базе несколько.
CLINIC_BOT_CLINIC_ID=
# Кнопки «Подтвердить / Отменить запись» под напоминанием в Telegram.
TELEGRAM_REMINDER_BUTTONS=true
# Чат операторов в Telegram и id сотрудников-админов бота (через запятую).
BOT_OPERATOR_CHAT_ID=
BOT_ADMIN_IDS=
# Контакты клиники для кнопки «О клинике» в боте. Пустые строки не показываются.
CLINIC_ADDRESS=
CLINIC_PHONE=
CLINIC_HOURS=
# Ссылка на политику обработки персональных данных — показывается перед подтверждением записи.
CLINIC_PRIVACY_URL=

# Адрес интерфейса. 127.0.0.1 — только этот компьютер; 0.0.0.0 — вся сеть.
APP_BIND=127.0.0.1
APP_PORT=8080
APP_VERSION=local

# ИИ-навигатор: OpenAI-compatible API. Ключ остаётся только на backend.
# Пусто — локальная навигация работает, обращения к модели выключены.
CLINIC_ASSISTANT_API_KEY=
CLINIC_ASSISTANT_MODEL=gpt-5.4-nano
CLINIC_ASSISTANT_API_URL=https://api.openai.com/v1

# Mango Office: Личный кабинет ВАТС → Интеграции → API-коннектор.
# Salt не передаётся в браузер. Пусто — кнопка звонка показывает, что Mango не подключён.
MANGO_API_KEY=
MANGO_API_SALT=
MANGO_API_URL=https://app.mango-office.ru
# Добавочный по умолчанию; в карточке пациента сотрудник может указать свой.
MANGO_DEFAULT_EXTENSION=
MANGO_LINE_NUMBER=
# Обязателен, если в AlphaCRM несколько клиник.
MANGO_CLINIC_ID=

# Платёжный терминал: имя адаптера банка и секрет HMAC его уведомлений в CRM.
# Сам драйвер банка/терминала подключается отдельно; эти переменные его не заменяют.
TERMINAL_PROVIDER=generic
TERMINAL_WEBHOOK_SECRET=
