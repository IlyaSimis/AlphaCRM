# Скопируйте в .env или выполните scripts/init-env.sh — он сгенерирует случайные секреты.
# .env не коммитится.

POSTGRES_DB=quiet_clinic
POSTGRES_USER=quiet_clinic
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=55432

# Ключ шифрования клинических текстов (минимум 32 символа).
# Не меняйте его на существующей базе: ранее зашифрованные данные станут нечитаемыми.
CLINIC_KMS_KEY=change-me-to-a-random-64-hex-string

# Название клиники и пароль начального администратора (логин admin) для пустой базы.
# Пароль обязателен, не короче 12 символов и не «admin»; после первого входа его нужно сменить.
# Других сотрудников заводит администратор в разделе «Сотрудники».
CLINIC_NAME=AlphaCRM
# ФИО начального администратора на пустой базе
CLINIC_ADMIN_NAME=Администратор
CLINIC_ADMIN_PASSWORD=admin

# true — cookie сессии только по HTTPS (включите за reverse proxy с сертификатом).
SESSION_COOKIE_SECURE=false

# Внешние выводы (см. README, «Внешние выводы»). Пусто — ничего наружу не уходит.
# Вебхук клиники: свой бот или SMS-шлюз. Секрет подписи HMAC — минимум 32 случайных символа.
CLINIC_OUTBOUND_WEBHOOK_URL=
CLINIC_OUTBOUND_WEBHOOK_SECRET=
# Telegram-бот клиники (если вебхук не задан). Пациенту нужен chat id в карточке.
TELEGRAM_BOT_TOKEN=
# Онлайн-касса для чеков и секрет подписи. Пусто — чек остаётся QUEUED.
CLINIC_CASHBOX_URL=
CLINIC_CASHBOX_SECRET=
# Часовой пояс времени в сообщении пациенту (расписание хранится в UTC).
CLINIC_TIME_ZONE=UTC

# Адрес интерфейса. 127.0.0.1 — только этот компьютер; 0.0.0.0 — вся сеть.
APP_BIND=127.0.0.1
APP_PORT=8080
APP_VERSION=local
