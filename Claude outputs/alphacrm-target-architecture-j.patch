+    # раздаётся сразу; фоновый проход повторяет то, что не раздалось.
+    enabled: ${CLINIC_EVENTS_ENABLED:true}
+    poll-interval: ${CLINIC_EVENTS_POLL_INTERVAL:PT30S}
+  registry:
+    # Задача регистратуры о нехватке на складе: название позиции и недостающее количество.
+    stock-shortage-title: "${CLINIC_STOCK_SHORTAGE_TITLE:Нехватка на складе — %s (не хватает %s)}"
+  inventory:
+    # Название основного склада, который создаётся сам при первом обращении к складу.
+    default-warehouse-name: ${CLINIC_DEFAULT_WAREHOUSE:Основной склад}
+  marking:
+    # Адаптер Честного знака: none — не настроено (операции ждут с MARKING_NOT_CONFIGURED),
+    # mock — заглушка MVP, отвечает «принято» и ничего не отправляет.
+    adapter: ${CLINIC_MARKING_ADAPTER:none}
+    relay-enabled: ${CLINIC_MARKING_RELAY_ENABLED:true}
+    poll-interval: ${CLINIC_MARKING_POLL_INTERVAL:PT60S}
+  drive:
+    # Корпоративный диск: файлы шифруются в сервисе и лежат в каталоге хранилища (Docker-том).
