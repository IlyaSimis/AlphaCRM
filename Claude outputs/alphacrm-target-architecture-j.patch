@@ -0,0 +1,112 @@
+import { useEffect, useState } from 'react'
+import { RefreshRounded } from '@mui/icons-material'
+import { Alert, Box, Button, Chip, MenuItem, Stack, TextField, Typography } from '@mui/material'
+import { loadMarkingCodes, loadMarkingOperations, loadMarkingStatus, retryMarkingOperation } from '../../api/inventory'
+import type { MarkingCodeItem, MarkingOperationItem, MarkingStatus } from '../../api/types'
+import { formatClinicMoment } from '../../shared/clinicTime'
+import { can } from '../../shared/permissions'
+import type { Role } from '../../shared/roles'
+import { Metric } from '../../shared/ui'
+import { adapterLabels, codeStatusLabels, operationErrorLabels, operationLabels, operationStatusLabels } from './inventory'
+
+type MarkingTabProps = { role: Role; notify: (message: string) => void }
+
+/**
+ * Маркировка (раздел G): очередь операций к оператору и реестр марок. Без настроенной интеграции
+ * операции ждут в очереди с причиной «не настроено»; остатки и накладные при этом работают.
+ */
+export function MarkingTab({ role, notify }: MarkingTabProps) {
+  const manage = can(role, 'inventory.marking.manage')
+  const codesAllowed = can(role, 'inventory.stock.read')
+  const [status, setStatus] = useState<MarkingStatus | null>(null)
+  const [operations, setOperations] = useState<MarkingOperationItem[]>([])
+  const [codes, setCodes] = useState<MarkingCodeItem[]>([])
+  const [filter, setFilter] = useState('')
+  const [codeFilter, setCodeFilter] = useState('')
+  const [error, setError] = useState('')
+  const [revision, setRevision] = useState(0)
+
+  useEffect(() => {
+    let cancelled = false
+    Promise.all([loadMarkingStatus(), loadMarkingOperations(filter), codesAllowed ? loadMarkingCodes(codeFilter) : Promise.resolve([] as MarkingCodeItem[])])
+      .then(([state, queue, registry]) => { if (!cancelled) { setStatus(state); setOperations(queue); setCodes(registry); setError('') } })
+      .catch((reason: Error) => { if (!cancelled) setError(reason.message) })
+    return () => { cancelled = true }
+  }, [filter, codeFilter, codesAllowed, revision])
+
+  const retry = async (operation: MarkingOperationItem) => {
+    try {
+      await retryMarkingOperation(operation.id)
+      notify('Операция отправлена повторно')
+      setRevision((value) => value + 1)
+    } catch (reason) {
+      setError((reason as Error).message)
+    }
+  }
+
+  return (
+    <>
+      {status && <Box className="summary-grid" sx={{ mb: 2 }}>
+        <Metric value={status.adapter} label="интеграция" note={adapterLabels[status.adapter] ?? status.adapter} accent={status.adapter === 'NONE'} />
+        <Metric value={String(status.pending)} label="в очереди" note="ждут ответа оператора" />
+        <Metric value={String(status.errors)} label="с ошибкой" note="нужен разбор" accent={status.errors > 0} />
+      </Box>}
+      {status?.adapter === 'NONE' && <Alert severity="info" sx={{ mb: 2 }}>Интеграция с Честным знаком не настроена: операции копятся в очереди и уйдут после подключения. Для лекарств вывод из оборота при медицинском применении идёт через регистратор выбытия (МДЛП) — уточните схему у оператора.</Alert>}
+      {error && <Alert severity="error" sx={{ mb: 2 }}>{error}</Alert>}
+      <Box className="panel" sx={{ mb: 2 }}>
+        <Stack direction="row" spacing={1.5} sx={{ mb: 1.5, alignItems: 'center' }}>
+          <Typography className="panel-label" sx={{ flex: 1 }}>ОПЕРАЦИИ МАРКИРОВКИ</Typography>
+          <TextField size="small" select label="Статус" value={filter} onChange={(event) => setFilter(event.target.value)} sx={{ minWidth: 160 }}>
+            <MenuItem value="">Все</MenuItem>
+            {Object.entries(operationStatusLabels).map(([value, label]) => <MenuItem key={value} value={value}>{label}</MenuItem>)}
+          </TextField>
+          <Button startIcon={<RefreshRounded />} onClick={() => setRevision((value) => value + 1)}>Обновить</Button>
+        </Stack>
+        {operations.length === 0
+          ? <Typography sx={{ color: 'text.secondary' }}>Операций нет.</Typography>
+          : <table className="audit-table">
+            <thead><tr><th>Создана</th><th>Операция</th><th>Марок</th><th>Статус</th><th>Попыток</th><th>Причина</th><th /></tr></thead>
+            <tbody>
+              {operations.map((operation) => (
+                <tr key={operation.id}>
+                  <td className="nowrap">{formatClinicMoment(operation.createdAt)}</td>
+                  <td>{operationLabels[operation.type] ?? operation.type}</td>
+                  <td>{operation.codes}</td>
+                  <td><Chip size="small" variant="outlined" label={operationStatusLabels[operation.status] ?? operation.status} color={operation.status === 'DONE' ? 'success' : operation.status === 'ERROR' ? 'error' : 'warning'} /></td>
+                  <td>{operation.attempts}</td>
+                  <td>{operation.lastError ? operationErrorLabels[operation.lastError] ?? operation.lastError : '—'}</td>
+                  <td>{manage && operation.status !== 'DONE' && <Button size="small" onClick={() => void retry(operation)}>Повторить</Button>}</td>
+                </tr>
+              ))}
+            </tbody>
+          </table>}
+      </Box>
+      {codesAllowed && <Box className="panel">
+        <Stack direction="row" spacing={1.5} sx={{ mb: 1.5, alignItems: 'center' }}>
+          <Typography className="panel-label" sx={{ flex: 1 }}>МАРКИ (SGTIN)</Typography>
+          <TextField size="small" select label="Статус марки" value={codeFilter} onChange={(event) => setCodeFilter(event.target.value)} sx={{ minWidth: 200 }}>
+            <MenuItem value="">Все</MenuItem>
+            {Object.entries(codeStatusLabels).map(([value, label]) => <MenuItem key={value} value={value}>{label}</MenuItem>)}
+          </TextField>
+        </Stack>
+        {codes.length === 0
+          ? <Typography sx={{ color: 'text.secondary' }}>Марок нет.</Typography>
+          : <table className="audit-table">
+            <thead><tr><th>SGTIN</th><th>Позиция</th><th>Партия</th><th>Годен до</th><th>Статус</th><th>Обновлена</th></tr></thead>
+            <tbody>
+              {codes.map((code) => (
+                <tr key={code.sgtin}>
+                  <td className="nowrap">{code.sgtin}</td>
+                  <td>{code.itemName}</td>
+                  <td>{code.batch || '—'}</td>
+                  <td>{code.expiresOn ?? '—'}</td>
+                  <td>{codeStatusLabels[code.status] ?? code.status}</td>
+                  <td className="nowrap">{formatClinicMoment(code.updatedAt)}</td>
+                </tr>
+              ))}
+            </tbody>
+          </table>}
+      </Box>}
+    </>
+  )
+}
diff --git a/src/features/inventory/NormsTab.tsx b/src/features/inventory/NormsTab.tsx
new file mode 100644
index 0000000..99b1798
--- /dev/null
+++ b/src/features/inventory/NormsTab.tsx
@@ -0,0 +1,95 @@
+import { useEffect, useState } from 'react'
+import { DeleteOutlineRounded } from '@mui/icons-material'
+import { Alert, Box, Button, IconButton, MenuItem, Stack, TextField, Typography } from '@mui/material'
+import { loadItems } from '../../api/inventory'
+import { loadServiceNorms, saveServiceNorms } from '../../api/schedule'
+import type { InventoryItem, ServiceItem } from '../../api/types'
+import { formatQuantity, parseQuantity } from './inventory'
+
+type NormsTabProps = { services: ServiceItem[]; canEdit: boolean; notify: (message: string) => void }
+
+type NormDraft = { key: string; itemId: string; quantity: string }
+
+/**
+ * Нормы расхода услуги (сценарий D7): при завершении приёма склад списывает эти позиции с
+ * основного склада. Немаркируемые — сразу, маркируемые — черновиком расхода для сканирования марок.
+ */
+export function NormsTab({ services, canEdit, notify }: NormsTabProps) {
+  const active = services.filter((service) => service.active)
+  const [serviceId, setServiceId] = useState(active[0]?.id ?? '')
+  const [items, setItems] = useState<InventoryItem[]>([])
+  const [norms, setNorms] = useState<NormDraft[]>([])
+  const [error, setError] = useState('')
+  const [busy, setBusy] = useState(false)
+
+  useEffect(() => {
+    loadItems({ sort: 'name' }).then(setItems).catch((reason: Error) => setError(reason.message))
+  }, [])
+
+  useEffect(() => {
+    if (!serviceId) return
+    let cancelled = false
+    loadServiceNorms(serviceId)
+      .then((rows) => { if (!cancelled) { setNorms(rows.map((row) => ({ key: crypto.randomUUID(), itemId: row.itemId, quantity: formatQuantity(row.quantity) }))); setError('') } })
+      .catch((reason: Error) => { if (!cancelled) setError(reason.message) })
+    return () => { cancelled = true }
+  }, [serviceId])
+
+  const save = async () => {
+    const parsed: Array<{ itemId: string; quantity: number }> = []
+    for (const norm of norms) {
+      if (!norm.itemId) continue
+      const quantity = parseQuantity(norm.quantity)
+      if (!quantity) {
+        setError('Количество — положительное число, например 1 или 0,5')
+        return
+      }
+      parsed.push({ itemId: norm.itemId, quantity })
+    }
+    if (new Set(parsed.map((norm) => norm.itemId)).size !== parsed.length) {
+      setError('Каждая позиция — в нормах один раз')
+      return
+    }
+    setBusy(true)
+    try {
+      await saveServiceNorms(serviceId, parsed)
+      notify('Нормы расхода сохранены')
+      setError('')
+    } catch (reason) {
+      setError((reason as Error).message)
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  const patch = (key: string, change: Partial<NormDraft>) => setNorms((current) => current.map((norm) => norm.key === key ? { ...norm, ...change } : norm))
+
+  return (
+    <Box className="panel">
+      <Typography sx={{ color: 'text.secondary', mb: 2 }}>При завершении приёма склад спишет эти позиции по норме услуги. Нехватка не блокирует приём — регистратура получит задачу.</Typography>
+      {error && <Alert severity="error" sx={{ mb: 2 }}>{error}</Alert>}
+      <TextField select label="Услуга" value={serviceId} onChange={(event) => setServiceId(event.target.value)} sx={{ minWidth: 280, mb: 2 }}>
+        {active.map((service) => <MenuItem key={service.id} value={service.id}>{service.name}</MenuItem>)}
+      </TextField>
+      <Stack spacing={1.5}>
+        {norms.length === 0 && <Typography sx={{ color: 'text.secondary' }}>Норм нет: приём со склада ничего не списывает.</Typography>}
+        {norms.map((norm) => {
+          const item = items.find((option) => option.id === norm.itemId)
+          return (
+            <Stack key={norm.key} direction="row" spacing={1.5} sx={{ alignItems: 'center' }}>
+              <TextField select size="small" label="Позиция" value={norm.itemId} disabled={!canEdit} onChange={(event) => patch(norm.key, { itemId: event.target.value })} sx={{ minWidth: 260 }}>
+                {items.map((option) => <MenuItem key={option.id} value={option.id}>{option.name}{option.marked ? ' · марк.' : ''}</MenuItem>)}
+              </TextField>
+              <TextField size="small" label={item ? `На приём, ${item.unit}` : 'На приём'} value={norm.quantity} disabled={!canEdit} onChange={(event) => patch(norm.key, { quantity: event.target.value })} sx={{ width: 150 }} />
+              {canEdit && <IconButton aria-label="Убрать норму" onClick={() => setNorms((current) => current.filter((row) => row.key !== norm.key))}><DeleteOutlineRounded /></IconButton>}
+            </Stack>
+          )
+        })}
+      </Stack>
+      {canEdit && <Stack direction="row" spacing={1} sx={{ mt: 2 }}>
+        <Button disabled={!serviceId || items.length === 0} onClick={() => setNorms((current) => [...current, { key: crypto.randomUUID(), itemId: '', quantity: '1' }])}>Добавить позицию</Button>
+        <Button variant="contained" disabled={!serviceId || busy} onClick={() => void save()}>Сохранить нормы</Button>
+      </Stack>}
+    </Box>
+  )
+}
diff --git a/src/features/inventory/inventory.test.ts b/src/features/inventory/inventory.test.ts
new file mode 100644
index 0000000..9b78dcb
--- /dev/null
+++ b/src/features/inventory/inventory.test.ts
@@ -0,0 +1,31 @@
+import { describe, expect, it } from 'vitest'
+import type { StockBalance } from '../../api/types'
+import { balanceAlert, formatQuantity, parseQuantity, warehousesOf } from './inventory'
+
+const row = (quantity: number, expiresOn: string | null): StockBalance => ({
+  itemId: 'i', itemName: 'Перчатки', categoryId: 'c', categoryName: 'Расходники', kind: 'CONSUMABLE', unit: 'пара',
+  marked: false, warehouseId: 'w', warehouseName: 'Основной склад', batch: '', expiresOn, quantity, codesInStock: 0,
+})
+
+describe('inventory rules', () => {
+  it('reads quantities with a comma and rejects zero or garbage', () => {
+    expect(parseQuantity('2')).toBe(2)
+    expect(parseQuantity('0,5')).toBe(0.5)
+    expect(parseQuantity('0')).toBeNull()
+    expect(parseQuantity('abc')).toBeNull()
+    expect(formatQuantity(1.25)).toBe('1,25')
+    expect(formatQuantity(3)).toBe('3')
+  })
+
+  it('asks for the right warehouses per document type', () => {
+    expect(warehousesOf('RECEIPT')).toEqual({ from: false, to: true })
+    expect(warehousesOf('CONSUMPTION')).toEqual({ from: true, to: false })
+    expect(warehousesOf('TRANSFER')).toEqual({ from: true, to: true })
+  })
+
+  it('flags negative stock and batches expiring within 30 days', () => {
+    expect(balanceAlert(row(-1, null), '2026-10-28')).toBe('negative')
+    expect(balanceAlert(row(5, '2026-11-20'), '2026-10-28')).toBe('expiring')
+    expect(balanceAlert(row(5, '2027-05-01'), '2026-10-28')).toBeNull()
+  })
+})
diff --git a/src/features/inventory/inventory.ts b/src/features/inventory/inventory.ts
new file mode 100644
