+  Warehouse(UUID clinicId, String name, boolean defaultWarehouse) {
+    id = UUID.randomUUID();
+    this.clinicId = clinicId;
+    this.name = name;
+    this.defaultWarehouse = defaultWarehouse;
+    createdAt = Instant.now();
+  }
+}
